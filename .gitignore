# Trained weights and scalers; keep small provenance reports
train/models/*
!train/models/*_manifest.json
!train/models/training_summary.json
*.pth
*.pt
*.joblib
*.pkl
/models/

# Evaluation plots are generated; retain the CSV score report
evaluation/plots/
plots/
evaluation/*
!evaluation/evaluation_results.csv

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db
