# Python bytecode and virtual environments
__pycache__/
*.py[cod]
*$py.class
venv/
env/
.venv/

# Local secrets and environment overrides
.env
.env.*
!.env.example

# Node.js and Next.js build output
node_modules/
.next/
out/
dist/
coverage/
*.tsbuildinfo

# Generated feature, split, and external weather data
data/features/
data/sequences/
data/era5_land_karnataka/
data/splits/
data/*.csv
!data/imd_data/
